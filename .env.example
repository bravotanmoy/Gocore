# ------------- Server -------------
APP_NAME=GocoreCMS
APP_ENV=development            # development | production
APP_PORT=8080
APP_URL=http://localhost:8080

# ------------- Database -------------
# DB_DRIVER: mysql (default) | postgres
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Gocore_cms
DB_USER=root
DB_PASSWORD=
# For postgres set DB_PORT=5432 and DB_SSLMODE
DB_SSLMODE=disable

# ------------- JWT Auth -------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_HOURS=168

# ------------- Payments -------------
# Providers are pluggable. Configure keys for the ones you use.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ------------- CORS -------------
# Comma separated list of allowed frontend origins (Next/Nuxt/plain HTML hosts)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------- Uploads -------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20
